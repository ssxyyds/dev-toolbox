{
  "name": "ssx-toolbox",
  "version": "1.0.0",
  "private": true,
  "description": "本地桌面工具箱：JSON、密码与 UUID、Base64 编解码、Unix 时间戳与北京时间互转",
  "author": "ssx",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-packager . SsxToolbox --platform=win32 --arch=x64 --out=release --overwrite --asar --icon=assets/icon.ico --ignore=\"^/(release|tests|scripts|\\.impeccable|.*\\.md$)\"",
    "test:desktop": "node scripts/test-desktop.cjs",
    "test:startup": "node scripts/test-startup.cjs",
    "test:json-nested": "node scripts/test-json-nested.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.0.0",
    "playwright": "1.62.1"
  },
  "dependencies": {
    "markdown-it": "15.0.3"
  }
}
